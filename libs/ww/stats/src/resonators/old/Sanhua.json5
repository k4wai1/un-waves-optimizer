  "mechanics": [],
  "lore": {
    "about": "A member of the Midnight Rangers, Sanhua is calm and collected in battle. She wields the power of Glacio with precision, freezing enemies solid before shattering them with her Forte Circuit.",
    "quote": "The frost spares no one. Neither do I."
  }
}
