      targets: [
      ],
      modifiers: [
      ],
      // [REVISAR] No pudo traducirse a modifier automaticamente.
      descriptionTemplate: "This Shield will not be passed on to the incoming Resonator.DerivationWhen Iuno casts Intro Skill or Resonance Liberation, she immediately gains 5 stacks of Blessing of the Wan Light.",
    },
    {
      id: "Iuno_s1",
      name: "S1: Wax or Wane, All Gild the Bough",
      operation: "add",
      value: [],
      maxStacks: 1,
      exclusive: false,
      enabledByDefault: false,
      targets: [
      ],
      modifiers: [
      ],
      // [REVISAR] No pudo traducirse a modifier automaticamente.
      // [NO SOPORTADO] Mecánica/secuencia condicional: requiere modelado manual.
      descriptionTemplate: "When Iuno is in Lunar Cycle, her ATK is increased by 40%. When Iuno is inside the Full Moon Domain, she additionally restores 1 point of Resonance Energy per second. Resonance Skill - Arc Beyond the Edge and Heavy Attack - Absolute Fullness become immune to interruption.",
    },
    {
      id: "Iuno_s2",
      name: "S2: Day or Night, Let This Be Eternal",
      operation: "add",
      value: [],
      maxStacks: 1,
