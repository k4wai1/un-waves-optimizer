    },
    {
      id: "Lucy_passive_11",
      name: "When",
      operation: "add",
      value: [],
      maxStacks: 1,
      exclusive: false,
      enabledByDefault: false,
      targets: [
      ],
      modifiers: [
      ],
      // [REVISAR] No pudo traducirse a modifier automaticamente.
      descriptionTemplate: "When Lucy is downed, she can no longer gain Network Backdoor, and any existing Network Backdoor effects become invalid.",
    },
    {
      id: "Lucy_s1",
      name: "S1: The Moon, a Ticket, and a Dream",
      operation: "add",
      value: [],
      maxStacks: 1,
      exclusive: false,
      enabledByDefault: false,
      targets: [
      ],
      modifiers: [
      ],
      // [REVISAR] No pudo traducirse a modifier automaticamente.
      // [NO SOPORTADO] Mecánica/secuencia condicional: requiere modelado manual.
      descriptionTemplate: "Lucy is now immune to interruptions during Resonance Skill - Payload, Resonance Skill - Pulse Inteference, Heavy Attack - Dual Threading, and Heavy Attack - Multi-Threading Casting Intro Skill - Outdated Hallucination increases ATK by 20% for 14s. When a Resonator in the team defeats a target affected by Spoofing Program with direct damage, Lucy records the effect triggered and activates the corresponding Quick Action on that Resonator for 6s. The record expires when Lucy is knocked out. Quick Action: When activated, inflict the recorded Spoofing Program effects on targets within a certain distance from the active Resonator in the team, effective once only on each target. The following Spoofing Program effects can be recorded: Spoofing Program: Cyberware Malfunction, Spoofing Program: Breach Protocol, Spoofing Program: Cripple Movement, Spoofing Program: Weapon Glitch, and Spoofing Program: Cyberpsychosis. When applying Spoofing Program effects via Quick Action, only the continuous status effects are applied.",
    },
    {
      id: "Lucy_s2",
      name: "S2: The Blackwall, the Past, the Escape",
      operation: "add",
      value: [],
      maxStacks: 1,
      exclusive: false,
      enabledByDefault: false,
      targets: [
      ],
      modifiers: [
      ],
      // [REVISAR] No pudo traducirse a modifier automaticamente.
      // [NO SOPORTADO] Mecánica/secuencia condicional: requiere modelado manual.
      descriptionTemplate: "While casting Resonance Liberation - Netrunner and Resonance Liberation - Old Net Deep Dive, Lucy's starting RAM is increased to 32. After casting Resonance Skill - Pulse Interference, deal 1 additional  of Spectro DMG equal to 450% of Lucy's ATK, considered Heavy Attack DMG. When this instance of damage hits the target, apply all of the following Spoofing Program effects: Spoofing Program: Cyberware Malfunction,  Spoofing Program: Breach Protocol, Spoofing Program: Cripple Movement, Spoofing Program: Weapon Glitch, and Spoofing Program: Cyberpsychosis. Only the continuous status effects are applied. Forte Circuit - Depths of Blackwall is enhanced: When casting Heavy Attack - Multi-threading, if Lucy has SQL, the DMG Multiplier increase is raised from 270% to 560%.",
    },
    {
      id: "Lucy_s3",
      name: "S3: Cyberpunk",
      operation: "add",
      value: [],
      maxStacks: 1,
      exclusive: false,
      enabledByDefault: false,
      targets: [
      ],
      modifiers: [
      ],
      // [REVISAR] No pudo traducirse a modifier automaticamente.
      // [NO SOPORTADO] Mecánica/secuencia condicional: requiere modelado manual.
      descriptionTemplate: "The DMG Multiplier of Override from Resonance Liberation - Netrunner and Resonance Liberation - Old Net Deep Dive is increased by 50%, and its Crit. DMG is increased by 100%. The DMG Multiplier of Spoofing Program: Cripple Movement is increased by 65%. The DMG Multiplier of Hack Response - Data Crash is increased by 65%.",
    },
    {
      id: "Lucy_s4",
      name: "S4: No Living Legends in Night City",
      operation: "add",
      value: [],
      maxStacks: 1,
      exclusive: false,
      enabledByDefault: false,
      targets: [
      ],
      modifiers: [
      ],
      // [REVISAR] No pudo traducirse a modifier automaticamente.
      // [NO SOPORTADO] Mecánica/secuencia condicional: requiere modelado manual.
      descriptionTemplate: "When Resonators in the team inflict Hack - Shifting, Resonators in the team gain 20% All-Attribute DMG Bonus for 20s.",
    },
    {
      id: "Lucy_s5",
      name: "S5: A Broken Path to Hell",
      operation: "add",
      value: [],
      maxStacks: 1,
      exclusive: false,
      enabledByDefault: false,
      targets: [
      ],
      modifiers: [
      ],
      // [REVISAR] No pudo traducirse a modifier automaticamente.
      // [NO SOPORTADO] Mecánica/secuencia condicional: requiere modelado manual.
      descriptionTemplate: "The stack limit of Optical Illusion obtainable via Inherent Skill - Ghost Cyberware is increased to 2. Inherent Skill - Ghost Cyberware is now enhanced: When Lucy's HP falls below 50%, she immediately gains 1  of Optical Illusion upon being hit. This effect has a Cooldown of 180s. When Optical Illusion is triggered, Lucy gains a Shield equal to 150% of ATK for 10s.",
    },
    {
      id: "Lucy_s6",
      name: "S6: I Really Want to Stay At Your House",
      operation: "add",
      value: [],
      maxStacks: 1,
      exclusive: false,
      enabledByDefault: false,
      targets: [
      ],
      modifiers: [
      ],
      // [REVISAR] No pudo traducirse a modifier automaticamente.
      // [NO SOPORTADO] Mecánica/secuencia condicional: requiere modelado manual.
      descriptionTemplate: "Targets with Hack - Shifting or in the Hack - Interfered state take 40% increased Heavy Attack DMG from Lucy. Targets with Hack - Shifting or in the Hack - Interfered state take 60% increased Hack DMG from Lucy. The Stagnation triggered by Hack Response - Data Crash now lasts for 1.5s.",
    },
