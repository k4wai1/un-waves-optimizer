      modifiers: [
      ],
      // [REVISAR] No pudo traducirse a modifier automaticamente.
      descriptionTemplate: "This effect can be triggered up to 1  every 0.5s.Function CrackingWhen Resonance Skill - Payload, Resonance Skill - Pulse Interference, or Resonance Skill - Deadlock damages an Overlord Class or Calamity Class enemy, Lucy applies Botnet Mark on them for 2 min.",
