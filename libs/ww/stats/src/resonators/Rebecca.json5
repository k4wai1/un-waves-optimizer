      descriptionTemplate: "When Rebecca casts Resonance Liberation - Party 'til Dawn!, the ATK of all nearby Resonators in the team is increased by 20% for 30s.",
    },
    {
      id: "Rebecca_s1",
      name: "S1: Try Not to Get in the Way!",
