  "mechanics": [],
  "lore": {
    "about": "The keeper of the shore between worlds, she guides lost souls through the stellar sea. Her presence alone brings calm to the most turbulent of waters.",
    "quote": "The tide waits for no one. But I can slow it down."
  }
